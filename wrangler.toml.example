# Hanya untuk deploy lewat terminal (wrangler). Deploy lewat GitHub tidak memakai file ini:
# binding D1 dan ADMIN_PASSWORD diatur di dashboard Cloudflare Pages.
# Untuk wrangler: salin menjadi wrangler.toml lalu isi database_id.

name = "toko-kaos"
pages_build_output_dir = "public"
compatibility_date = "2026-10-01"

[[d1_databases]]
binding = "DB"
database_name = "toko-kaos-db"
database_id = "GANTI_DENGAN_DATABASE_ID"
